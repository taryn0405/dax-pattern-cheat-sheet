// FactInvoices
// Mock invoice data: 120 rows across 3 programs and 4 vendors.
// Dates run from 2024-10-01 to 2026-09-30 (FY2025 and FY2026 with an October fiscal start).
// Values are generated by formula, so the table is identical every time it loads.
// All data is fabricated.

let
    Programs = {"Program A", "Program B", "Program C"},
    Vendors = {"Acme Staffing", "Globex Talent", "Initech Services", "Umbrella Workforce"},

    Rows = List.Transform(
        {1..120},
        each [
            InvoiceID = _,
            Date = Date.AddDays(#date(2024, 10, 1), Number.Mod(_ * 37, 730)),
            Program = Programs{Number.Mod(_, 3)},
            Vendor = Vendors{Number.Mod(_, 4)},
            Amount = 500 + Number.Mod(_ * 173, 4500)
        ]
    ),

    Result = Table.FromRecords(
        Rows,
        type table [InvoiceID = Int64.Type, Date = date, Program = text, Vendor = text, Amount = number]
    )
in
    Result
